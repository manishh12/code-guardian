PORT=8787
DATABASE_URL=postgres://guardian:guardian@localhost:5432/code_guardian

# LLM: groq (free cloud) | ollama (local, free) | mock (no key needed)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Local free hashing embeddings (no API). Swap to Ollama embeddings later if desired.
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=

# Paid-equivalent estimate only (dashboard). Actual free providers stay $0.
OPENAI_INPUT_USD_PER_1M=0.15
OPENAI_OUTPUT_USD_PER_1M=0.60
